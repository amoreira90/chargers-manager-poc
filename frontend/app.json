{
  "expo": {
    "name": "ProseApp",
    "slug": "ProseApp",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "proseapp",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.proseapp.app",
      "infoPlist": {
        "LSApplicationQueriesSchemes": ["comgooglemaps", "waze", "maps"]
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#1E90FF",
        "foregroundImage": "./assets/images/android-icon-foreground.png"
      },
      "edgeToEdgeEnabled": true,
      "package": "com.proseapp.app",
      "queries": {
        "schemes": ["comgooglemaps", "waze", "geo"]
      }
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      [
        "expo-camera",
        {
          "cameraPermission": "Allow ProseApp to access your camera to scan QR codes"
        }
      ],
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "Allow ProseApp to access your location to show nearby chargers"
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#ffffff"
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "proseapp"
      }
    }
  }
}
