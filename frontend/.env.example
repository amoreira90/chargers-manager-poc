# Configuración de ejemplo para ProseApp
# Copia este archivo a .env y actualiza los valores

# Backend API
EXPO_PUBLIC_API_URL=http://localhost:8080

# Configuración de API
EXPO_PUBLIC_API_TIMEOUT=10000

# Ambiente (development, staging, production)
EXPO_PUBLIC_ENV=development

# Configuración de pagos
EXPO_PUBLIC_MERCADOPAGO_PUBLIC_KEY=TEST-your-mercadopago-key
EXPO_PUBLIC_GOOGLE_PAY_MERCHANT_ID=your-google-merchant-id

# Configuración de mapa
EXPO_PUBLIC_GOOGLE_MAPS_API_KEY=your-google-maps-api-key
